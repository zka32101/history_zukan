# ============================================================================
# Firestore Upload Script - Environment Variables
# ============================================================================
#
# Usage:
#   1. Copy this file to .env
#   2. Fill in your Firebase credentials
#   3. Run: node upload_gacha_persons.js
#
# Note:
#   - Do NOT commit .env to Git (add to .gitignore)
#   - Use service-account-key.json for local development
#   - Use environment variables in production/CI/CD
#
# ============================================================================

# Firebase Service Account Key Path
# If not set, script will look for ./service-account-key.json
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Firebase Project ID (optional, defaults to petit-works-education)
# FIREBASE_PROJECT_ID=petit-works-education

# Node environment
NODE_ENV=development
