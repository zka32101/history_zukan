rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ========== person_photos ディレクトリ ==========
    // 人物画像：全員読取可（アプリ内表示用）
    // 管理者のみアップロード・削除（デプロイスクリプト経由）
    match /person_photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
                      request.auth.token.admin == true;
    }

    // ========== event_photos ディレクトリ ==========
    // イベント画像：全員読取可（アプリ内表示用）
    // 管理者のみアップロード・削除（将来の拡張用）
    match /event_photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
                      request.auth.token.admin == true;
    }

    // ========== その他 ==========
    // デフォルト：アクセス禁止
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
