# Android release signing configuration.
#
# Usage:
#   1. Generate an upload keystore (once):
#        keytool -genkey -v -keystore upload-keystore.jks \
#          -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#   2. Copy this file to android/key.properties (NOT committed — see .gitignore)
#   3. Fill in the values below
#   4. Keep the .jks file OUTSIDE the repo, or gitignored if kept alongside it
#
# Without this file, `flutter build apk/appbundle --release` falls back to
# the debug keystore — fine for local testing, but NEVER upload a
# debug-signed build to Google Play.

storePassword=changeme
keyPassword=changeme
keyAlias=upload
storeFile=/absolute/path/to/upload-keystore.jks
